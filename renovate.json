{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>suitenumerique/ci//renovate/default"],
  "enabledManagers": ["github-actions"],
  "timezone": "Europe/Paris",
  "packageRules": [
    {
      "description": "Update GitHub Actions versions and pinned SHAs once a month, in a single PR",
      "groupName": "GitHub Actions dependencies",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major", "minor", "patch", "digest", "pinDigest"],
      "schedule": ["* 0-6 1 * *"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Actions from this repository are intentionally referenced by tag",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["suitenumerique/ci"],
      "pinDigests": false,
      "enabled": false
    }
  ]
}
